# ==========================================
# SERVER ENVIRONMENT VARIABLES (Backend)
# Create a .env file inside the /server folder
# ==========================================

# Port the backend runs on
PORT=5000

# MongoDB Connection String (Atlas for production, local for development)
MONGO_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/productr?retryWrites=true&w=majority

# Secret for signing JWTs
JWT_SECRET=your_jwt_secret_here

# Twilio Credentials (Required for SMS OTP)
TWILIO_ACCOUNT_SID=your_twilio_sid
TWILIO_AUTH_TOKEN=your_twilio_token
TWILIO_VERIFY_SERVICE_SID=your_twilio_verify_sid

# SMTP Credentials (Required for Email OTP, e.g., Gmail App Passwords)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password

# ==========================================
# CLIENT ENVIRONMENT VARIABLES (Frontend)
# Create a .env file inside the /client folder
# ==========================================

# URL pointing to the deployed backend (or localhost for dev)
VITE_API_URL=http://localhost:5000
