# Server Configuration
PORT=5000
NON_STANDARD_MONGO=true

# Database Options
# For local memory/ephemeral development testing, leave blank to autogenerate an in-memory db
# For production/persistence, pass your MongoDB Atlas Connection URI
MONGO_URI=

# Authentication
# Secret used to sign JSON Web Tokens
JWT_SECRET=your_jwt_secret_here

# SMS Service (Twilio)
# Used for real-time Phone Number OTP verification
# Get these from your Twilio Console (https://console.twilio.com/)
TWILIO_ACCOUNT_SID=your_account_sid_here
TWILIO_AUTH_TOKEN=your_auth_token_here
TWILIO_VERIFY_SERVICE_SID=your_verify_service_sid_here

# Email Service (Nodemailer via SMTP)
# Used for real-time Email OTP verification
# E.g., Use a Gmail App Password if using Gmail
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password_here
